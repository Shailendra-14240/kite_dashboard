# --- Kite Connect (from developers.kite.trade) ---
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_REDIRECT_URL=http://127.0.0.1:5000/callback

# --- Market data provider ---
# "kite"  = spot prices via kite.ltp() (needs paid Kite Connect market-data access)
# "paytm" = spot prices via your free Paytm Money Open API account (positions/holdings/
#           funds still come from Kite either way — only the price lookup changes)
MARKET_DATA_PROVIDER=kite

# --- Paytm Money (only needed if MARKET_DATA_PROVIDER=paytm) ---
# Create an app at https://developer.paytmmoney.com — free, Trading + Market Data included.
PAYTM_API_KEY=
PAYTM_API_SECRET=
PAYTM_REDIRECT_URL=http://127.0.0.1:5000/paytm_callback

# --- Email alerts ---
# For Gmail: enable 2FA on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that here (not your real password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# --- Risk thresholds ---
ITM_WARNING_PCT=3.0
MARGIN_BUFFER_PCT=15.0
CHECK_INTERVAL_MINUTES=5
ALERT_COOLDOWN_MINUTES=30

# --- Flask ---
FLASK_SECRET_KEY=change-this-to-something-random
FLASK_PORT=5000
